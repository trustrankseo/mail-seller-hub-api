# Firebase Trigger Email extension (optional) and in-app notifications
MAIL_COLLECTION=mail
NOTIFICATIONS_COLLECTION=notifications
PAYMENT_CLAIMS_COLLECTION=payment_transactions

# Required for trusted website/admin inventory update requests
ADMIN_SYNC_SECRET=
