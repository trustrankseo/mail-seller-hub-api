# Telegram
TELEGRAM_BOT_TOKEN=

# Firebase Admin (choose ONE setup)
# Option A: one-line service account JSON
FIREBASE_SERVICE_ACCOUNT=

# Option B: split service account fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Store collections / settings
PRODUCTS_COLLECTION=products
SUBSCRIBERS_COLLECTION=telegram_subscribers
ORDERS_COLLECTION=orders
SESSIONS_COLLECTION=telegram_sessions
PAYMENT_DOC_PATH=settings/payment
DEFAULT_CURRENCY=USD

# Payment fallback
PAYMENT_LABEL=Binance USDT
PAYMENT_NETWORK=USDT
PAYMENT_CURRENCY=USDT
BINANCE_ADDRESS=
BSC_RPC_URL=https://bsc-dataseed-public.bnbchain.org
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BSC_USDT_DECIMALS=18
BSC_MIN_CONFIRMATIONS=1
